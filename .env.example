# ============================================================================
# Desafio Global Summit 2026 — Exemplo de Variáveis de Ambiente (.env.example)
# Copie para .env e preencha com os valores do seu ambiente.
# NUNCA versione arquivos .env com senhas ou credenciais reais.
# ============================================================================

# Ambiente de execução ('development' ou 'production')
NODE_ENV=development

# Porta HTTP do servidor Express
PORT=3001

# Caminho do banco de dados SQLite (em produção, apontar para volume persistente)
DESAFIO_DB_PATH=./server/db/desafio_global.sqlite

# Diretório privado de armazenamento de evidências (em produção, apontar para volume persistente)
DESAFIO_EVIDENCE_DIR=./server/storage/evidences

# Diretório de destino padrão para o script de backup consistente (server/scripts/backup.ts)
DESAFIO_BACKUP_DIR=./server/backups

# Duração das sessões autenticadas em milissegundos (padrão: 28800000 = 8 horas)
SESSION_TTL_MS=28800000

# Origens CORS autorizadas separadas por vírgula (obrigatório em produção; nunca usar '*')
# Exemplo: CORS_ALLOWED_ORIGINS=https://desafio.seudominio.com.br
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Confiança em cabeçalho X-Forwarded-For para rate limiting atrás de proxy reverso ('true' ou 'false')
TRUST_PROXY=false

# Limites de rate limiting nativo em memória (instância única)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ADMIN_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_UPLOAD_MAX=20

# URL base da API para o build do frontend Vite (padrão: /api via proxy reverso same-origin)
VITE_API_BASE_URL=/api

# Provisionamento opcional da primeira conta administrativa (deixe vazio após criar o admin)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_PASSWORD=
